# Copy to deploy/.env and fill in. The app validates everything at boot and
# refuses to start with a clear message when something required is missing.

# ---- Site --------------------------------------------------------------
# Point this name's DNS A/AAAA records at the VPS before starting; Caddy gets the certificate.
DOMAIN=lantern.example.com
# 32+ random bytes: openssl rand -base64 48
APP_SECRET=
POSTGRES_PASSWORD=

# ---- Sign-in (ADR-0018) ------------------------------------------------------
# dev = no sign-in yet; the whole site sits behind DEV_GATE_PASSWORD (HTTP Basic).
AUTH_MODE=dev
DEV_GATE_PASSWORD=
# Later: AUTH_MODE=clerk with CLERK_SECRET_KEY + CLERK_PUBLISHABLE_KEY,
# or AUTH_MODE=workos with WORKOS_API_KEY + WORKOS_CLIENT_ID + WORKOS_COOKIE_PASSWORD.

# ---- AI and voice -----------------------------------------------------------
ANTHROPIC_API_KEY=
# HOST_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
# DEFAULT_VOICE_ID=

# ---- Self-hosted voice (services/tts, ADR-0021) -----------------------------
# Brazilian Portuguese only, on this server's CPUs, no per-character bill.
# Start it with docker compose --profile tts up -d, then set a secret (openssl rand -hex 24).
POCKET_TTS_SECRET=
POCKET_TTS_VOICE=rafael
TTS_CPUS=2

# ---- TikTok signer (apps/signer, ADR-0023) ---------------------------------
# Our own replacement for the hosted Euler Stream sign server. To turn it on: start it with
# docker compose --profile signer up -d, and set the next two (the token is openssl rand -hex 24).
# SIGNER_URL=http://lantern-signer:8091
# SIGNER_TOKEN=
# TikTok may show a login wall to data-center addresses; if the signer reports an empty answer,
# send its traffic through a residential or mobile proxy: http://user:pass@host:port
# SIGNER_PROXY_URL=
# SIGNER_LOCALE=en-US
# SIGNER_TIMEZONE=America/New_York
# SIGNER_CPUS=1
# Instead of the signer: EULER_API_KEY, the hosted sign server's key (higher rate limits).
# EULER_API_KEY=

# ---- Billing: Mercado Pago (ADR-0013) ---------------------------------------
# Leave both empty to run without billing (everyone gets the Self-hosted plan).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
BILLING_CURRENCY=BRL
PLAN_PRICE_CREATOR=49.90
PLAN_PRICE_PRO=149.90

# ---- Cloud broadcast (ADR-0014, ADR-0020) -----------------------------------
# Also start the broadcaster: docker compose --profile broadcast up -d
BROADCAST_ENABLED=false
# openssl rand -hex 24 (shared by app and broadcaster)
BROADCASTER_TOKEN=
BROADCAST_MAX_CONCURRENT=1
BROADCASTER_CPUS=3
# auto (Chrome encodes H.264 in the page) or x264 (about 1 vCPU more per broadcast)
VIDEO_ENCODER=auto

# ---- Backups -------------------------------------------------------------
BACKUP_AT=03:15
# Optional off-site copies (any S3-compatible storage):
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info
