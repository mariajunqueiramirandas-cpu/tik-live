# Copy to .env and fill in what you need. Everything is optional: with no
# settings at all you get the simulator audience and the offline scripted host.

# --- Audience ---------------------------------------------------------------
# Your TikTok @handle (without the @). When set, the engine reads your real
# LIVE chat/gifts; when empty it runs a simulated audience.
TIKTOK_USERNAME=
# Optional Euler Stream key used by tiktok-live-connector's sign server
# (higher rate limits). https://www.eulerstream.com
EULER_API_KEY=
# Force a source: tiktok | simulator
# EVENT_SOURCE=simulator
# Simulated events per second.
SIMULATOR_RATE=0.5

# --- Brain (Claude) -----------------------------------------------------------
# With a key the host is driven by Claude; without one it uses canned lines.
ANTHROPIC_API_KEY=
# Force the brain: claude | scripted. Use claude when you're signed in with
# `ant auth login` instead of setting a key.
# HOST_BRAIN=claude
HOST_MODEL=claude-opus-5-5
# low = fastest replies. Raise to medium/high for wittier but slower turns.
HOST_EFFORT=low
# Second-opinion moderation of every sentence before it is spoken.
SAFETY_LLM=true
SAFETY_MODEL=claude-opus-5-5
# If the moderator errors: false = drop the sentence (safe), true = speak it.
SAFETY_FAIL_OPEN=false

# --- Voice --------------------------------------------------------------------
# none = captions only. elevenlabs = real voice.
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- OBS (optional, for hands-free streaming) ----------------------------------
# OBS > Tools > WebSocket Server Settings. When set, the engine starts the
# stream and restarts it if it drops. Usually ws://127.0.0.1:4455
OBS_WS_URL=
OBS_WS_PASSWORD=
OBS_AUTOSTART=true

# --- Server -------------------------------------------------------------------
BIND_HOST=127.0.0.1
PORT=4545
# Required if you expose the control panel beyond localhost.
CONTROL_TOKEN=

# --- Show ---------------------------------------------------------------------
PERSONA=personas/blip.json
BLOCKLIST=config/blocklist.txt
DATA_DIR=data
# Seconds of silence before the host fills dead air.
DEAD_AIR_SECONDS=7
LOG_LEVEL=info
