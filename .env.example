# Development settings for `bun run dev`. Copy to .env and fill in what you
# need. Everything is optional: with nothing set you get an embedded database,
# no sign-in, simulated audiences and an offline scripted host.
#
# Every variable is documented in apps/server/src/config.ts. Production
# settings live in deploy/.env.example.

# --- AI host -------------------------------------------------------------------
# With a key, hosts and the safety moderator run on Claude (real, paid calls).
ANTHROPIC_API_KEY=
# Every plan runs on claude-haiku-5-5; override the host or moderator model for every plan here.
# HOST_MODEL=
# MODERATION_MODEL=
# Skip the host model's thinking for a faster first word (Claude Haiku 5.5): HOST_THINKING=off
# Never let the moderator think, for the fastest verdict (it thinks on odd names by default): MODERATION_THINKING=off
# How far behind real time viewers see the stream; games and pacing allow for it:
# STREAM_DELAY_MS=5000

# --- Voice ---------------------------------------------------------------------
# With a key, hosts speak out loud; without, they talk in captions.
# The default voice: Fish Audio's Drama 3 through OpenRouter (ADR-0030), Brazilian
# voices that act each line's emotion, about US$ 0.07 a live hour.
OPENROUTER_API_KEY=
# FISH_TTS_VOICE=4b0adc6775774eb48b92c7e99ac92a89
# Replaces the built-in voices with voices you have the rights to: id=Name,id=Name
# FISH_TTS_VOICES=
# Or ElevenLabs:
ELEVENLABS_API_KEY=
# DEFAULT_VOICE_ID=
# Or the self-hosted Brazilian Portuguese voice (services/tts/README.md has how to run it):
# POCKET_TTS_URL=http://localhost:8793
# POCKET_TTS_SECRET=

# --- TikTok --------------------------------------------------------------------
# Optional Euler Stream key for the TikTok connector's sign server (higher rate limits).
# EULER_API_KEY=

# --- Billing -------------------------------------------------------------------
# Leave unset in development: every account is then on the self-hosted plan with
# everything unlocked. Set both to try billing, with Mercado Pago TEST credentials only.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# --- Database --------------------------------------------------------------------
# Defaults to an embedded Postgres (PGlite) in apps/server/.data. Point at a real
# Postgres to test against it: postgres://user:password@localhost:5432/lantern
# DATABASE_URL=

# LOG_LEVEL=debug
