# Development settings for `bun run dev`. Copy to .env and fill in what you
# need. Everything is optional: with nothing set you get an embedded database,
# no sign-in, simulated audiences and an offline scripted host.
#
# Every variable is documented in apps/server/src/config.ts. Production
# settings live in deploy/.env.example.

# --- AI host -------------------------------------------------------------------
# With a key, hosts and the safety moderator run on Claude (real, paid calls).
ANTHROPIC_API_KEY=
# Override every plan's models while developing, e.g. claude-haiku-5-5 to keep costs down.
# HOST_MODEL=
# MODERATION_MODEL=

# --- Voice ---------------------------------------------------------------------
# With a key, hosts speak out loud; without, they talk in captions.
ELEVENLABS_API_KEY=
# DEFAULT_VOICE_ID=
# Or the self-hosted Brazilian Portuguese voice (services/tts/README.md has how to run it):
# POCKET_TTS_URL=http://localhost:8793
# POCKET_TTS_SECRET=

# --- TikTok --------------------------------------------------------------------
# The connector needs TikTok's request signing. Either use our own signer (apps/signer,
# ADR-0023; run it with `bun run --filter @tik-live/signer dev`) ...
# SIGNER_URL=http://127.0.0.1:8091
# SIGNER_TOKEN=            # 24+ characters, the same value the signer is started with
# ... or the hosted Euler Stream sign server (optional key: higher rate limits). The signer wins when both are set.
# EULER_API_KEY=
# TikTok may refuse to let a data-center address join a room. Oxylabs residential proxies (the proxy
# user's name and password from the Oxylabs dashboard) fix that; the signer and the app both read these:
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# OXYLABS_COUNTRY=BR
# TIKTOK_WS_VIA_PROXY=false   # also send each channel's websocket through it (costs traffic)

# --- Billing -------------------------------------------------------------------
# Leave unset in development: every account is then on the self-hosted plan with
# everything unlocked. Set both to try billing, with Mercado Pago TEST credentials only.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# --- Database --------------------------------------------------------------------
# Defaults to an embedded Postgres (PGlite) in apps/server/.data. Point at a real
# Postgres to test against it: postgres://user:password@localhost:5432/lantern
# DATABASE_URL=

# LOG_LEVEL=debug
